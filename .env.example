# Adobe Developer Console credentials for Frame.io API
# Get these from: https://developer.adobe.com/console → your project → OAuth Web App credential
FRAMEIO_CLIENT_ID=your_client_id_here
FRAMEIO_CLIENT_SECRET=your_client_secret_here

# OAuth relay page — hosted on GitHub Pages
FRAMEIO_OAUTH_RELAY_URL=https://aiscalestudio.github.io/frameio-mcp/callback.html

# Optional: override where tokens are stored (default: ~/.frameio-mcp/tokens.json)
# FRAMEIO_TOKENS_PATH=/custom/path/tokens.json
