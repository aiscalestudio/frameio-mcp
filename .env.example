# There are two separate deployment modes with two different variable sets.
# Mixing them up is easy: FRAMEIO_OAUTH_RELAY_URL belongs to the CLI and
# FRAMEIO_BASE_URL belongs to the hosted server. They are not interchangeable.

# ---------------------------------------------------------------------------
# Shared by both modes
# ---------------------------------------------------------------------------
# From https://developer.adobe.com/console -> your project -> OAuth Web App
FRAMEIO_CLIENT_ID=your_client_id_here
FRAMEIO_CLIENT_SECRET=your_client_secret_here

# ---------------------------------------------------------------------------
# Local CLI only (frameio-mcp login / status / verify / serve)
# ---------------------------------------------------------------------------
# The page that displays the authorization code for you to paste back.
# Must be registered as a redirect URI in the Adobe console.
FRAMEIO_OAUTH_RELAY_URL=https://aiscalestudio.github.io/frameio-mcp/callback.html

# Optional: override where the CLI stores tokens.
# Default: ~/.frameio-mcp/tokens.json
# FRAMEIO_TOKENS_PATH=/custom/path/tokens.json

# ---------------------------------------------------------------------------
# Hosted server only (Vercel, or `frameio-mcp serve --http`)
# ---------------------------------------------------------------------------
# Public origin of the deployment, no trailing slash. The OAuth callback is
# derived from it as {FRAMEIO_BASE_URL}/auth/callback, which must be registered
# as a redirect URI in the Adobe console. A mismatch here surfaces as an opaque
# Adobe error rather than anything diagnostic.
FRAMEIO_BASE_URL=https://your-deployment.vercel.app

# Signs the tokens the server issues to Claude. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER change this once users are connected: every existing token stops
# validating and everyone is signed out.
JWT_SIGNING_KEY=generate_a_long_random_value

# Encrypts upstream Adobe tokens at rest in Redis. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=generate_a_fernet_key

# Redis connection string. Must be the redis:// or rediss:// protocol URL, not
# an Upstash https:// REST endpoint. Required because OAuth client registrations
# have to outlive any single serverless instance; see spike/FINDINGS.md.
REDIS_URL=rediss://default:password@host:6379
